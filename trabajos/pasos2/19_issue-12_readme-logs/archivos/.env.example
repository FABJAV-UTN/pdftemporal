# Copiar a .env y ajustar. Todas tienen valores por defecto (app/config/settings.py).

# MongoDB: "mongo" es el servicio de docker-compose.yml; sin Docker, usar localhost.
MONGO_URL=mongodb://mongo:27017
DB_NAME=pdf_extraction_db

# Aplicación
MAX_PDF_SIZE_MB=10
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
LOG_LEVEL=INFO
